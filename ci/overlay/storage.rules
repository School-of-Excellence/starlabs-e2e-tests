rules_version = '2';
// ⚠️ EMULATOR-ONLY permissive Storage rules (atc suite media uploads, 2026-10-13). Referenced only by
// firebase.emulator.json — never deploy these. The real bucket's rules live in the Firebase console.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if true;
    }
  }
}
