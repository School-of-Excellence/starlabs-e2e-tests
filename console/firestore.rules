rules_version = '2';

// Release console security rules (plan D2, 2026-06-22) — the REAL access fence.
// The UI gates buttons for UX; THESE rules are what actually stop unauthorized access.
//
// Reads require: signed in + @soexcellence.com + an ACTIVE member doc.
// All writes to release-candidates / activity-log are SERVER-ONLY (the callables and
// webhook receiver use the Admin SDK, which bypasses these rules) — clients can never
// write workflow state directly. Member docs are admin-readable; a user may read only
// their OWN member doc (needed by the login gate).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function callerEmail() {
      return request.auth.token.email.lower();
    }

    function emailDomainOk() {
      return signedIn()
        && callerEmail().matches('^[a-z0-9._%+-]+@soexcellence[.]com$');
    }

    function memberPath() {
      // One doc per member in the top-level CICD-Users collection (id = lowercased email).
      return /databases/$(database)/documents/CICD-Users/$(callerEmail());
    }

    function isActiveMember() {
      return emailDomainOk()
        && exists(memberPath())
        && get(memberPath()).data.active == true;
    }

    function hasRole(role) {
      return isActiveMember() && (role in get(memberPath()).data.roles);
    }

    // Workflow state — read for any active member. Writes are server-only (Admin SDK), with ONE
    // narrow exception: the GLOBAL mute (usability plan 2026-07-02). An active developer/admin may
    // patch ONLY the three mute fields; every other field stays server-written. affectedKeys()
    // .hasOnly(...) is what fences this to mute — a client cannot smuggle a workflow-state change.
    match /release-candidates/{id} {
      allow read: if isActiveMember();
      allow update: if isActiveMember()
        && (hasRole('developer') || hasRole('admin'))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['mutedSha', 'mutedBy', 'mutedAt']);
      allow create, delete: if false;
    }

    match /activity-log/{id} {
      allow read: if isActiveMember();
      allow write: if false;
    }

    // Members — login gate needs a user to read their OWN doc; admins read all.
    // Writes only via the setMember callable (Admin SDK).
    match /CICD-Users/{email} {
      allow get: if signedIn() && callerEmail() == email;
      allow list, read: if hasRole('admin');
      allow write: if false;
    }

    // Legacy/derived allowlist doc — readable by active members; server-written only.
    match /console-config/allowlists {
      allow read: if isActiveMember();
      allow write: if false;
    }

    // Suites manifest MIRROR (master plan 2026-07-02, L1) — ONE-WAY: hub git → mirror-suites.yml
    // → recordSuitesManifest (Admin SDK). The console only READS it (Test Run dialog catalogue);
    // no client may ever write it — edits happen via PR in the hub repo.
    match /console-config/suites {
      allow read: if isActiveMember();
      allow write: if false;
    }

    // CF deploy matrix (plan L15/L17) — one doc per Cloud Function, Dev/Prod columns. Written only
    // by recordCfDeploy (postdeploy hook) + reconcilePoll's CF-API heal (Admin SDK). CF Board is a
    // developer/admin screen; scope reads accordingly.
    match /cf-functions/{name} {
      allow read: if hasRole('developer') || hasRole('admin');
      allow write: if false;
    }

    // Per-developer console prefs (pinned branches) — PRIVATE. A user reads/writes only their OWN
    // doc (id = lowercased email). Client-written directly (usability plan 2026-07-02).
    match /user-prefs/{email} {
      allow read, write: if emailDomainOk() && callerEmail() == email;
    }

    // Append-only CI/CD run history — written server-side by scripts/history/record-run.cjs
    // (Admin SDK, bypasses rules). Read for active members so the console / history view can
    // resolve a gate run's archived Playwright report by githubRunId. Scoped to the same
    // member fence as release-candidates (tighter than the dashboard README's `auth != null`).
    match /cicd-audit/{runId} {
      allow read: if isActiveMember();
      allow write: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
